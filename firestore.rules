rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile collection
    match /users/{userId} {
      // Authenticated users can read friend profiles and their own profile
      allow read: if isAuthenticated();
      
      // User can create or update their own profile
      allow create, update: if isOwner(userId);
      
      // Paired friend can update pairedWith fields during reciprocal pairing/unpairing
      allow update: if isAuthenticated() && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['pairedWithUserId', 'pairedWithName'])
      );
      
      allow delete: if isOwner(userId);
    }

    // Fast 6-digit lookup code directory
    match /pairing_codes/{code} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Pings collection
    match /pings/{pingId} {
      // Only the sender and recipient can read pings
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      
      // Sender can create pings directed to their paired friend
      allow create: if isAuthenticated() && 
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId != request.auth.uid;
        
      allow update, delete: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }
  }
}
